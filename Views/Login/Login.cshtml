@{
    ViewBag.Title = "Login";
}

<div class="container" style="margin-top: 50px;">
    <div class="row">
        <div class="col-md-4 col-md-offset-4 col-sm-6 col-sm-offset-3">
            <div class="panel panel-default shadow-sm" style="border-radius: 8px; border: 1px solid #e3e3e3; padding: 30px; background: #fff;">
                
                @* Início do formulário apontando para a Action Login da LoginController *@
                @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { @class = "form-signin" }))
                {
                    @* Proteção contra ataques CSRF casando com o [ValidateAntiForgeryToken] do Controller *@
                    @Html.AntiForgeryToken()

                    <h2 class="form-signin-heading text-center" style="margin-bottom: 25px; font-weight: 300; color: #333;">
                        Hub<span style="font-weight: 700; color: #0275d8;">Space</span>
                    </h2>

                    
                    if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" style="padding: 10px; font-size: 14px; border-radius: 4px;">
                            @Html.ValidationSummary(true, "")
                        </div>
                    }

                    <div class="form-group" style="margin-bottom: 15px;">
                        <label for="Email" class="control-label" style="font-size: 13px; color: #666;">E-mail</label>
                        <input type="email" id="Email" name="Email" class="form-control" placeholder="exemplo@gmail.com" required autofocus 
                               style="height: 45px; border-radius: 4px;">
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label for="Password" class="control-label" style="font-size: 13px; color: #666;">Senha</label>
                        <input type="password" id="Password" name="Password" class="form-control" placeholder="Sua senha" required
                               style="height: 45px; border-radius: 4px;">
                    </div>

                    <div class="checkbox" style="margin-bottom: 20px; padding-left: 5px;">
                        <label style="color: #666; font-size: 14px;">
                            <input type="checkbox" id="LembrarMe" name="LembrarMe" value="true"> Lembrar de mim
                        </label>
                    </div>

                    @* O type="submit" em um <button> envia os dados diretamente p banco *@
                    <button class="btn btn-lg btn-primary btn-block" type="submit" 
                            style="height: 45px; font-size: 16px; font-weight: 600; border-radius: 4px; background-color: #0275d8; border: none; transition: background 0.2s;">
                        Entrar
                    </button>
                }
            </div>
            
            <p class="text-center" style="margin-top: 20px; color: #888; font-size: 13px;">
                &copy; @DateTime.Now.Year - HubSpace. Todos os direitos reservados.
            </p>
        </div>
    </div>
</div>